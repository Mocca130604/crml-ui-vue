{
  "name": "crml-ui",
  "version": "2.0.2",
  "type": "module",
  "main": "./dist/crml-ui.umd.cjs",
  "module": "./dist/crml-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/crml-ui.js",
      "require": "./dist/crml-ui.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-s build:types build:lib",
    "build:lib": "vite build",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "sync:all": "node scripts/sync-frameworks.mjs --all",
    "sync:tokens": "node scripts/sync-frameworks.mjs --tokens",
    "sync:icons": "node scripts/sync-icons.mjs",
    "sync:check": "node scripts/sync-frameworks.mjs --check"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "npm-run-all2": "^6.1.1",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vite-plugin-dts": "^3.7.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Mocca130604",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mocca130604/crml-ui-vue.git"
  }
}
